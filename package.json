{
  "name": "@efrencode/pi-status-footer",
  "version": "0.1.0",
  "description": "Pi TUI 状态脚注：cwd、git 分支、模型、token、缓存命中、成本与上下文用量",
  "type": "module",
  "license": "MIT",
  "keywords": ["pi-package"],
  "engines": { "node": ">=22.19.0" },
  "pi": { "extensions": ["./index.ts"] },
  "files": [
    "index.ts",
    "src/**",
    "README.md",
    "LICENSE",
    "package.json",
    "package-lock.json"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "pack:check": "npm pack --dry-run"
  },
  "dependencies": {},
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@earendil-works/pi-tui": "1.5.0",
    "@types/node": "^22.19.0",
    "typescript": "^5.9.3"
  }
}
